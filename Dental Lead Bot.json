      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output;\n\nconst firstBrace = aiOutput.indexOf('{');\nconst lastBrace = aiOutput.lastIndexOf('}');\n\nif (firstBrace === -1 || lastBrace === -1) {\n  return [{ json: { action: 'error', message: 'JSON не найден', raw: aiOutput } }];\n}\n\nconst jsonString = aiOutput.substring(firstBrace, lastBrace + 1);\n\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonString);\n} catch (e) {\n  return [{ json: { action: 'error', message: 'Ошибка парсинга', raw: aiOutput } }];\n}\n\nconst originalCode = $('Code in JavaScript').first().json;\n\nreturn [{\n  json: {\n    action: parsed.action,\n    message: parsed.message,\n    lead_data: parsed.lead_data || {},\n    chatId: originalCode.chatId,\n    firstName: originalCode.firstName,\n    userId: originalCode.userId,\n    originalText: originalCode.text\n  }\n}];"
      },
